# Copie para .streamlit/secrets.toml (NAO versionar) para rodar o app fora do
# Streamlit in Snowflake. Dentro do SiS nada disso e necessario.
[connections.snowflake]
account = "sua_conta"            # ex.: abc12345.sa-east-1
user = "seu_usuario"
# uma das duas formas:
password = "sua_senha"
# authenticator = "externalbrowser"
role = "SEU_PAPEL"
warehouse = "SEU_WAREHOUSE"
database = "BASES_SAPR"
schema = "AGENTE_SAPR"
